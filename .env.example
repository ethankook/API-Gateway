# --- JWT ---
# Must be at least 32 bytes for HS256.
JWT_SECRET_KEY=replace-with-at-least-32-bytes

# --- Gateway/Scheduler Internal Auth ---
GATEWAY_INTERNAL_TOKEN=replace-with-a-random-shared-internal-token

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=4432
DB_NAME=orchard
DB_USER=localuser
DB_PASSWORD=replace-with-a-database-password

# --- Service URLs ---
SCHEDULER_URL=http://localhost:9191
